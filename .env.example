# ==============================================================================
# Harmausam Meteorological Platform — Environment Configuration
# ==============================================================================

# Base Map Tile URL
# Defaults to CartoDB Dark No-Labels (no API key required, zero watermarks).
# Alternative clean options:
# - CartoDB Dark No-Labels: https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png
# - Esri Dark Gray Canvas: https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
# - OpenStreetMap Carto: https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"

# Optional Live Weather Data Provider Keys
# Open-Meteo operational multi-model ensemble requires no API key for standard non-commercial use.
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
