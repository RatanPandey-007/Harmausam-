# ==============================================================================
# Harmausam Meteorological Platform — Environment Configuration
# ==============================================================================

# Map Provider Abstraction
# Supported options: "maptiler" | "carto" | "openfreemap"
# If VITE_MAPTILER_API_KEY is provided, MapTiler vector basemaps are activated.
# If no key is set, the platform automatically utilizes a clean, open vector
# basemap (OpenFreeMap Positron / CARTO Positron) in Demo Mode with zero blocking overlays.
VITE_MAP_PROVIDER=maptiler
VITE_MAPTILER_API_KEY=

# Custom MapLibre Vector Style URL (Optional override)
# e.g., https://api.maptiler.com/maps/dataviz-light/style.json?key=YOUR_KEY
# or https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL=

# Centralized Weather Data Architecture Configuration (Phase 1)
# Primary data provider mode: "mock" (default research benchmark testbed) | "live"
VITE_WEATHER_PROVIDER=mock

# Optional Live Weather Data Provider Keys (Phase 2 Preparation)
# Open-Meteo operational multi-model ensemble requires no API key for standard non-commercial use.
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
VITE_WEATHER_API_KEY=

# Observational Verification Provider Keys
# RapidAPI key for Meteostat surface observations (optional).
# If not configured, empirical observations report UNAVAILABLE without fabricating ground truth.
VITE_METEOSTAT_API_KEY=

